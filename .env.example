# 大模型 API 配置参考样例（实际请在网页「设置」页填写，三选一）
# 本项目在网页设置页把配置保存到 data/settings.json，本文件仅供对照参考。

# 服务商选择：doubao | openai | deepseek
LLM_PROVIDER=doubao

# 豆包（火山方舟）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1.6-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# GitHub Token（可选，不填也能搜，只是额度更低。GitHub Settings -> Developer settings -> Personal access tokens）
GITHUB_TOKEN=

# Gitee Token（可选，不填也能搜）
GITEE_TOKEN=
